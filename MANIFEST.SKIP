# Version control and editor files
\bCVS
(^|/)\.
~$
\.swp$

# MakeMaker and build tools
^MANIFEST
^Makefile(?:\.PL|\.old)?$
^(?:MY)?META\.(?:yml|json)$
^blib/
^pm_to_blib$
^Dockerfile$
^compose\.yml$

# Development documentation and tests
^docs/
^specs/
^plugins/Jev/(?:t|xt)/
node_modules/

# Packages and staging directories (also excluded on subsequent builds)
^Jev-[^/]+/
\.(?:zip|tar(?:\.gz)?)$
